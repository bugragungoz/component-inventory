{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Component Inventory",
  "version": "1.0.0-beta.4",
  "identifier": "com.bugragungoz.component-inventory",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Component Inventory",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "backgroundColor": "#131110"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "capabilities": ["main"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["component-inventory"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Bugra Gungoz",
    "copyright": "Copyright (c) 2026 Bugra Gungoz. MIT License.",
    "category": "Utility",
    "shortDescription": "Local inventory of electronic components",
    "longDescription": "Keeps an inventory of electronic components on your computer and imports orders from Turkish electronics shops through a browser extension, PDF and Excel files.",
    "homepage": "https://github.com/bugragungoz/component-inventory",
    "resources": {
      "../patched.db": "patched.db"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "version": "1.0.0.4",
        "language": ["en-US", "tr-TR"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    }
  }
}
