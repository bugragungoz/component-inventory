{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "default_locale": "tr",
  "version": "1.0.0.4",
  "version_name": "1.0.0-beta.4",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["*://*.ozdisan.com/*", "*://*.direnc.net/*", "*://*.motorobit.com/*", "*://*.robocombo.com/*", "*://*.robiz.com.tr/*", "*://*.robotistan.com/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.ozdisan.com/*", "*://*.direnc.net/*", "*://*.motorobit.com/*", "*://*.robocombo.com/*", "*://*.robiz.com.tr/*", "*://*.robotistan.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
