{
  "name": "component-inventory",
  "private": true,
  "version": "1.0.0-beta.4",
  "type": "module",
  "description": "Local-first inventory of electronic components, with a browser extension for Turkish electronics shops.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "npm run tokens && vite build",
    "tauri": "tauri",
    "tokens": "node tools/tokens/build-tokens.mjs",
    "check:tokens": "node tools/tokens/build-tokens.mjs --check",
    "check:locales": "node tools/i18n/check-locales.mjs",
    "check:versions": "node tools/check-versions.mjs",
    "check:colors": "node tools/lint/no-hard-coded-colors.mjs",
    "lint": "eslint . && npm run check:colors",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p extension/tsconfig.json",
    "test": "vitest run",
    "test:rust": "cargo test -p inventory-core",
    "test:ui": "cargo build -p inventory-bridge && vite build && node tests/ui/run.mjs",
    "test:visual": "cargo build -p inventory-bridge && vite build && node tests/ui/visual.mjs",
    "test:ext": "node extension/build.mjs && node extension/tests/e2e.mjs",
    "ext:build": "node extension/build.mjs",
    "ext:zip": "node extension/build.mjs --zip",
    "icons": "node tools/brand/icons.mjs",
    "brand": "node tools/brand/icons.mjs && node tools/brand/installer.mjs && node tools/brand/social.mjs",
    "shots": "cargo build -p inventory-bridge && vite build && node tests/ui/screenshots.mjs",
    "verify": "npm run check:versions && npm run check:tokens && npm run check:locales && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource/geist-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@preact/signals": "2.11.3",
    "@tauri-apps/api": "2.10.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "pdfjs-dist": "5.7.284",
    "preact": "10.29.8",
    "qrcode": "1.5.4",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/preact": "3.2.4",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.56.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.5"
  }
}
